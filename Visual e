<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Visual Eternum — Contenido Diseñado para Quedarse</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   IDENTIDAD VISUAL ETERNUM — GOLD LUXURY
═══════════════════════════════════════ */
:root{
  --black:#050505;
  --dark:#0B0B0B;
  --surface:#111111;
  --surface2:#171717;
  --white:#F5F5F5;
  --muted:#B8B8B8;
  --muted2:#888888;
  --gold:#D4AF37;
  --gold-soft:#E7C867;
  --gold-dark:#8A6A16;
  --gold-dim:#C4A030;
  --border:rgba(212,175,55,.18);
  --border-glow:rgba(212,175,55,.32);
  --glow:rgba(212,175,55,.10);
  --glow2:rgba(212,175,55,.06);
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{
  font-family:'Montserrat',sans-serif;
  background:var(--black);
  color:var(--white);
  overflow-x:hidden;
  cursor:none;
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}

/* ─── CURSOR ─── */
#cursor-dot{
  position:fixed;width:6px;height:6px;
  background:var(--gold);border-radius:50%;
  pointer-events:none;z-index:9999;
  transform:translate(-50%,-50%);
  transition:width .18s,height .18s,background .18s;
  box-shadow:0 0 8px rgba(212,175,55,.6);
}
#cursor-ring{
  position:fixed;width:30px;height:30px;
  border:1px solid rgba(212,175,55,.35);border-radius:50%;
  pointer-events:none;z-index:9998;
  transform:translate(-50%,-50%);
  transition:width .22s,height .22s,border-color .2s;
}
#cursor-glow{
  position:fixed;width:240px;height:240px;
  background:radial-gradient(circle,rgba(212,175,55,.05) 0%,transparent 70%);
  border-radius:50%;pointer-events:none;z-index:9996;
  transform:translate(-50%,-50%);
}
body.hovering #cursor-dot{width:12px;height:12px;background:var(--gold-soft);}
body.hovering #cursor-ring{width:48px;height:48px;border-color:rgba(212,175,55,.5);}

/* ─── NAV ─── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:500;
  padding:20px 64px;
  display:flex;justify-content:space-between;align-items:center;
  background:linear-gradient(to bottom,rgba(5,5,5,.92) 0%,transparent 100%);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid transparent;
  transition:border-color .4s,padding .3s;
}
nav.scrolled{border-color:var(--border);padding:16px 64px;}
.nav-logo{
  font-family:'Bebas Neue',sans-serif;font-size:1.5rem;
  letter-spacing:.14em;color:var(--white);text-decoration:none;
}
.nav-logo em{color:var(--gold);font-style:normal;}
.nav-links{display:flex;gap:36px;list-style:none;}
.nav-links a{
  text-decoration:none;color:var(--muted2);font-size:.68rem;
  font-weight:500;letter-spacing:.12em;text-transform:uppercase;
  transition:color .2s;position:relative;
}
.nav-links a::after{
  content:'';position:absolute;bottom:-3px;left:0;right:0;height:1px;
  background:var(--gold);transform:scaleX(0);transition:transform .25s;
  transform-origin:left;
}
.nav-links a:hover{color:var(--white);}
.nav-links a:hover::after{transform:scaleX(1);}
.nav-cta{
  padding:10px 24px;background:transparent;color:var(--gold);
  font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  text-decoration:none;border:1px solid var(--border);border-radius:2px;
  transition:all .25s;
}
.nav-cta:hover{
  background:rgba(212,175,55,.08);border-color:var(--border-glow);
  transform:translateY(-1px);box-shadow:0 4px 20px rgba(212,175,55,.12);
}

/* ─── HERO ─── */
.hero{
  min-height:100vh;display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;position:relative;
  padding:120px 64px 80px;overflow:hidden;gap:60px;
}
.hero-bg{position:absolute;inset:0;z-index:0;overflow:hidden;}
.blob{position:absolute;border-radius:50%;filter:blur(100px);pointer-events:none;will-change:transform;}
.blob-1{
  width:700px;height:700px;
  background:radial-gradient(circle,rgba(212,175,55,.09) 0%,transparent 70%);
  top:-120px;right:-60px;animation:blobFloat1 14s ease-in-out infinite;
}
.blob-2{
  width:500px;height:500px;
  background:radial-gradient(circle,rgba(212,175,55,.06) 0%,transparent 70%);
  bottom:-80px;left:5%;animation:blobFloat2 18s ease-in-out infinite;
}
.blob-3{
  width:320px;height:320px;
  background:radial-gradient(circle,rgba(212,175,55,.04) 0%,transparent 70%);
  top:45%;left:38%;animation:blobFloat3 22s ease-in-out infinite;
}
@keyframes blobFloat1{0%,100%{transform:translate(0,0) scale(1);}40%{transform:translate(-24px,36px) scale(1.04);}70%{transform:translate(18px,-18px) scale(.97);}}
@keyframes blobFloat2{0%,100%{transform:translate(0,0) scale(1);}45%{transform:translate(36px,-28px) scale(1.03);}75%{transform:translate(-18px,22px) scale(.97);}}
@keyframes blobFloat3{0%,100%{transform:translate(0,0);}55%{transform:translate(-32px,-40px);}}
.grid-lines{
  position:absolute;inset:0;
  background-image:linear-gradient(rgba(212,175,55,.012) 1px,transparent 1px),
    linear-gradient(90deg,rgba(212,175,55,.012) 1px,transparent 1px);
  background-size:90px 90px;
  mask-image:radial-gradient(ellipse 80% 80% at 50% 40%,black 20%,transparent 100%);
  -webkit-mask-image:radial-gradient(ellipse 80% 80% at 50% 40%,black 20%,transparent 100%);
}
.grain{
  position:absolute;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.05'/%3E%3C/svg%3E");
  opacity:.3;pointer-events:none;mix-blend-mode:overlay;
}
.hero-bottom-fade{
  position:absolute;bottom:0;left:0;right:0;height:240px;
  background:linear-gradient(to bottom,transparent,var(--black));
  z-index:1;pointer-events:none;
}
#particles{position:absolute;inset:0;z-index:0;pointer-events:none;}

/* HERO LEFT */
.hero-left{
  position:relative;z-index:10;
  display:flex;flex-direction:column;justify-content:center;
  padding-right:32px;
}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-size:.62rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;
  color:var(--gold-soft);margin-bottom:36px;padding:7px 16px;
  border:1px solid rgba(212,175,55,.2);border-radius:100px;
  background:rgba(212,175,55,.04);width:fit-content;
  opacity:0;animation:fadeUp .8s .1s ease forwards;
}
.eyebrow-dot{
  width:5px;height:5px;background:var(--gold);border-radius:50%;
  animation:pulseGold 2s ease-in-out infinite;
  box-shadow:0 0 8px rgba(212,175,55,.8);
}
@keyframes pulseGold{0%,100%{transform:scale(1);box-shadow:0 0 6px rgba(212,175,55,.7);}50%{transform:scale(1.4);box-shadow:0 0 16px rgba(212,175,55,.4),0 0 32px rgba(212,175,55,.15);}}
.hero-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(4rem,7vw,8rem);
  line-height:.88;letter-spacing:.025em;color:var(--white);
}
.title-line{display:block;overflow:hidden;}
.title-word{display:inline-block;opacity:0;transform:translateY(105%);}
.title-word.visible{animation:wordReveal .75s cubic-bezier(.16,1,.3,1) forwards;}
@keyframes wordReveal{to{opacity:1;transform:translateY(0);}}
.title-gold{color:var(--gold);text-shadow:0 0 60px rgba(212,175,55,.3),0 0 120px rgba(212,175,55,.1);}
.title-outline{color:transparent;-webkit-text-stroke:1.5px var(--gold);}
.title-outline2{color:transparent;-webkit-text-stroke:1.5px rgba(212,175,55,.6);}
.hero-sub{
  font-size:clamp(.84rem,1.3vw,.96rem);font-weight:300;
  color:var(--muted);line-height:1.85;max-width:440px;
  margin-top:30px;letter-spacing:.025em;
  opacity:0;animation:fadeUp .9s .75s ease forwards;
}
.hero-sub strong{color:var(--white);font-weight:500;}
.hero-actions{
  display:flex;gap:14px;margin-top:44px;flex-wrap:wrap;
  opacity:0;animation:fadeUp .9s .95s ease forwards;
}
.btn-primary{
  padding:15px 36px;background:var(--gold);color:#000;
  font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  text-decoration:none;border-radius:2px;
  transition:all .28s cubic-bezier(.16,1,.3,1);
  position:relative;overflow:hidden;
  border:1px solid transparent;
  display:inline-flex;align-items:center;gap:10px;
}
.btn-primary::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,transparent 35%,rgba(255,255,255,.15) 50%,transparent 65%);
  transform:translateX(-200%);transition:transform .65s ease;
}
.btn-primary:hover::after{transform:translateX(220%);}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 40px rgba(212,175,55,.3),0 3px 10px rgba(212,175,55,.2);
  background:var(--gold-soft);
}
.btn-arrow{font-size:1rem;transition:transform .2s ease;}
.btn-primary:hover .btn-arrow{transform:translateX(5px);}
.btn-ghost{
  padding:15px 36px;background:transparent;color:var(--muted);
  font-size:.72rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;
  text-decoration:none;border-radius:2px;border:1px solid rgba(255,255,255,.1);
  transition:all .25s ease;
}
.btn-ghost:hover{
  border-color:var(--border);background:rgba(212,175,55,.04);
  color:var(--white);transform:translateY(-2px);
}
.hero-metrics{
  display:flex;gap:0;margin-top:64px;
  opacity:0;animation:fadeUp .9s 1.15s ease forwards;
}
.metric{
  padding-right:40px;margin-right:40px;
  border-right:1px solid rgba(212,175,55,.15);
}
.metric:last-child{border-right:none;margin-right:0;padding-right:0;}
.metric-num{
  font-family:'Bebas Neue',sans-serif;font-size:2.6rem;
  letter-spacing:.03em;line-height:1;color:var(--white);
}
.metric-num .acc{color:var(--gold);}
.metric-label{
  font-size:.58rem;font-weight:500;letter-spacing:.12em;
  text-transform:uppercase;color:var(--muted2);margin-top:6px;line-height:1.5;
}

/* ─── PHONE ─── */
.hero-right{
  position:relative;z-index:10;
  display:flex;justify-content:center;align-items:center;
  height:100%;min-height:600px;
}
.phone-scene{
  position:relative;width:272px;height:572px;
  perspective:1400px;animation:phoneFloat 7s ease-in-out infinite;
}
@keyframes phoneFloat{
  0%,100%{transform:translateY(0px) rotateY(-7deg) rotateX(3deg);}
  50%{transform:translateY(-20px) rotateY(-4deg) rotateX(2deg);}
}
.phone-shell{
  width:100%;height:100%;
  background:linear-gradient(150deg,#1c1c1c 0%,#0e0e0e 50%,#141414 100%);
  border-radius:44px;
  border:1px solid rgba(212,175,55,.15);
  position:relative;overflow:hidden;
  box-shadow:
    0 0 0 1px rgba(0,0,0,.7),
    0 50px 100px rgba(0,0,0,.9),
    0 0 80px rgba(212,175,55,.06),
    inset 0 1px 0 rgba(212,175,55,.08),
    inset 0 -1px 0 rgba(0,0,0,.4);
  transform-style:preserve-3d;
}
.phone-screen{
  position:absolute;top:14px;left:12px;right:12px;bottom:14px;
  background:#000;border-radius:34px;overflow:hidden;
}
.phone-notch{
  position:absolute;top:12px;left:50%;transform:translateX(-50%);
  width:88px;height:24px;background:#000;border-radius:12px;
  z-index:30;display:flex;align-items:center;justify-content:center;gap:6px;
}
.notch-cam{width:8px;height:8px;background:#111;border-radius:50%;border:1px solid rgba(255,255,255,.04);}
.notch-speaker{width:36px;height:4px;background:#0a0a0a;border-radius:2px;}
.video-reel{
  position:absolute;top:0;left:0;right:0;
  animation:reelScroll 11s linear infinite;will-change:transform;
}
@keyframes reelScroll{0%{transform:translateY(0);}100%{transform:translateY(-50%);}}
.video-card{width:100%;background:#0a0a0a;margin-bottom:2px;position:relative;overflow:hidden;}
.vc1{height:220px;background:linear-gradient(180deg,#0d0a00 0%,#1a1200 100%);}
.vc2{height:240px;background:linear-gradient(180deg,#080808 0%,#121010 100%);}
.vc3{height:200px;background:linear-gradient(180deg,#0a0800 0%,#1a1400 100%);}
.vc4{height:230px;background:linear-gradient(180deg,#0d0a00 0%,#1c1500 100%);}
.vc5{height:220px;background:linear-gradient(180deg,#0d0a00 0%,#1a1200 100%);}
.vc6{height:240px;background:linear-gradient(180deg,#080808 0%,#121010 100%);}
.vc7{height:200px;background:linear-gradient(180deg,#0a0800 0%,#1a1400 100%);}
.vc8{height:230px;background:linear-gradient(180deg,#0d0a00 0%,#1c1500 100%);}
.vc-glow{
  position:absolute;inset:0;
  background:radial-gradient(ellipse 120% 80% at 50% 60%,rgba(212,175,55,.07) 0%,transparent 70%);
  animation:vcGlowPulse 3.5s ease-in-out infinite;
}
@keyframes vcGlowPulse{0%,100%{opacity:.5;}50%{opacity:1;}}
.vc-ui{position:absolute;inset:0;padding:12px;display:flex;flex-direction:column;justify-content:flex-end;}
.waveform{display:flex;align-items:flex-end;gap:2px;height:28px;margin-bottom:8px;}
.waveform-bar{width:3px;background:rgba(212,175,55,.65);border-radius:2px;animation:waveAnim 1.3s ease-in-out infinite;}
.waveform-bar:nth-child(2){animation-delay:.1s;}.waveform-bar:nth-child(3){animation-delay:.2s;}
.waveform-bar:nth-child(4){animation-delay:.05s;}.waveform-bar:nth-child(5){animation-delay:.15s;}
.waveform-bar:nth-child(6){animation-delay:.25s;}.waveform-bar:nth-child(7){animation-delay:.08s;}
.waveform-bar:nth-child(8){animation-delay:.18s;}.waveform-bar:nth-child(9){animation-delay:.12s;}
.waveform-bar:nth-child(10){animation-delay:.22s;}
@keyframes waveAnim{0%,100%{height:5px;}50%{height:calc(5px + 18px * var(--h,.5));}}
.subtitle-bar{
  background:rgba(0,0,0,.75);backdrop-filter:blur(10px);
  border-radius:6px;padding:6px 10px;font-size:.56rem;font-weight:500;
  color:var(--white);letter-spacing:.04em;line-height:1.4;
  border:1px solid rgba(212,175,55,.12);
}
.subtitle-bar span{color:var(--gold-soft);}
.progress-bar{margin-top:7px;height:2px;background:rgba(255,255,255,.08);border-radius:1px;overflow:hidden;}
.progress-fill{height:100%;border-radius:1px;background:linear-gradient(to right,var(--gold-dark),var(--gold-soft));}
.stats-row{display:flex;gap:7px;margin-bottom:9px;align-items:center;}
.stat-pill{
  background:rgba(212,175,55,.12);border:1px solid rgba(212,175,55,.2);
  border-radius:100px;padding:2px 8px;font-size:.5rem;font-weight:600;
  color:var(--gold-soft);letter-spacing:.05em;
  display:flex;align-items:center;gap:3px;
}
.stat-pill.dim{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.6);}
.like-anim{position:absolute;top:14px;right:14px;display:flex;flex-direction:column;align-items:center;gap:3px;}
.like-icon{font-size:1.1rem;animation:likeHeart 2.8s ease-in-out infinite;filter:drop-shadow(0 0 5px rgba(212,175,55,.4));}
@keyframes likeHeart{0%,88%,100%{transform:scale(1);}94%{transform:scale(1.2);}}
.like-count{font-size:.5rem;font-weight:600;color:rgba(255,255,255,.65);}
.retention-chart{
  position:absolute;top:14px;left:12px;
  background:rgba(0,0,0,.55);backdrop-filter:blur(8px);
  border:1px solid rgba(212,175,55,.14);border-radius:8px;padding:7px 9px;width:104px;
}
.rc-title{font-size:.46rem;color:var(--muted2);letter-spacing:.1em;text-transform:uppercase;margin-bottom:5px;}
.rc-bars{display:flex;align-items:flex-end;gap:2px;height:22px;}
.rc-bar{
  flex:1;border-radius:2px 2px 0 0;
  background:linear-gradient(to top,var(--gold),rgba(212,175,55,.3));
  animation:rcAnim 3.2s ease-in-out infinite;
}
.rc-bar:nth-child(1){height:58%;}.rc-bar:nth-child(2){height:74%;animation-delay:.1s;}
.rc-bar:nth-child(3){height:52%;animation-delay:.2s;}.rc-bar:nth-child(4){height:92%;animation-delay:.3s;}
.rc-bar:nth-child(5){height:68%;animation-delay:.4s;}.rc-bar:nth-child(6){height:84%;animation-delay:.5s;}
@keyframes rcAnim{0%,100%{opacity:.65;}50%{opacity:1;}}
.rc-val{font-size:.52rem;font-weight:700;color:var(--gold-soft);margin-top:4px;}
.engagement-line{
  position:absolute;top:12px;right:12px;
  background:rgba(0,0,0,.55);backdrop-filter:blur(8px);
  border:1px solid rgba(212,175,55,.12);border-radius:8px;padding:7px 9px;width:96px;
}
.el-title{font-size:.46rem;color:var(--muted2);letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px;}
.el-value{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;color:var(--gold-soft);line-height:1;}
.el-change{font-size:.46rem;color:var(--gold);letter-spacing:.04em;}
.timeline-scrubber{
  margin-top:7px;height:3px;background:rgba(255,255,255,.07);
  border-radius:2px;overflow:visible;position:relative;
}
.tl-fill{
  height:100%;background:linear-gradient(to right,var(--gold-dark),var(--gold-soft));
  border-radius:2px;animation:tlScrub 4.5s ease-in-out infinite;
}
@keyframes tlScrub{0%{width:12%;}100%{width:84%;}}
.tl-thumb{
  width:8px;height:8px;background:var(--gold-soft);border-radius:50%;
  position:absolute;top:-2.5px;
  box-shadow:0 0 8px rgba(212,175,55,.7);
  animation:tlThumb 4.5s ease-in-out infinite;
}
@keyframes tlThumb{0%{left:12%;}100%{left:calc(84% - 4px);}}
.play-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:2;}
.play-btn{
  width:42px;height:42px;background:rgba(212,175,55,.1);
  border:1px solid rgba(212,175,55,.35);border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-size:.9rem;
  backdrop-filter:blur(8px);box-shadow:0 0 24px rgba(212,175,55,.15);
}
.phone-glow-ring{
  position:absolute;top:-24px;left:-24px;right:-24px;bottom:-24px;
  border-radius:64px;
  background:radial-gradient(ellipse at 50% 50%,rgba(212,175,55,.05) 0%,transparent 70%);
  pointer-events:none;animation:glowRingPulse 5s ease-in-out infinite;
}
@keyframes glowRingPulse{0%,100%{opacity:.4;transform:scale(1);}50%{opacity:1;transform:scale(1.02);}}
.phone-deco{position:absolute;display:flex;flex-direction:column;gap:8px;}
.phone-deco-left{left:-70px;top:50%;transform:translateY(-50%);}
.phone-deco-right{right:-70px;top:50%;transform:translateY(-50%);}
.deco-tag{
  background:rgba(12,10,0,.85);border:1px solid var(--border);
  border-radius:8px;padding:9px 12px;width:56px;
  display:flex;flex-direction:column;align-items:center;gap:3px;
  backdrop-filter:blur(10px);
}
.deco-icon{font-size:.95rem;}
.deco-val{font-family:'Bebas Neue',sans-serif;font-size:.95rem;color:var(--white);line-height:1;}
.deco-lbl{font-size:.36rem;color:var(--muted2);letter-spacing:.08em;text-transform:uppercase;text-align:center;}
.floating-badge{
  position:absolute;background:rgba(8,7,0,.9);
  border:1px solid var(--border-glow);border-radius:12px;
  padding:11px 16px;backdrop-filter:blur(16px);
  box-shadow:0 10px 40px rgba(0,0,0,.5),0 0 0 1px rgba(212,175,55,.08);
  animation:badgeFloat 5.5s ease-in-out infinite;
}
.badge-tl{top:10%;left:-96px;animation-delay:0s;}
.badge-br{bottom:18%;right:-86px;animation-delay:2.8s;}
@keyframes badgeFloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-9px);}}
.badge-label{font-size:.5rem;color:var(--muted2);letter-spacing:.1em;text-transform:uppercase;margin-bottom:3px;}
.badge-val{font-family:'Bebas Neue',sans-serif;font-size:1.25rem;color:var(--white);line-height:1;}
.badge-sub{font-size:.48rem;color:var(--gold-soft);letter-spacing:.06em;}
.badge-spark{color:var(--gold);font-size:.48rem;}
.scroll-hint{
  position:absolute;bottom:36px;left:64px;z-index:10;
  display:flex;align-items:center;gap:12px;
  opacity:0;animation:fadeIn 1s 2s ease forwards;
}
.scroll-line{width:40px;height:1px;background:linear-gradient(to right,transparent,var(--gold));}
.scroll-text{font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted2);}

