  font-size:.5rem;backdrop-filter:blur(4px);
}
.tl-bar{height:3px;background:rgba(255,255,255,.06);border-radius:2px;overflow:visible;position:relative;margin-bottom:18px;}
.tl-f{height:100%;background:linear-gradient(to right,var(--gold-dark),var(--gold-soft));border-radius:2px;animation:tlPlay 4.5s ease-in-out infinite;}
@keyframes tlPlay{0%{width:5%;}100%{width:90%;}}
.tl-dot{width:9px;height:9px;background:var(--gold-soft);border-radius:50%;position:absolute;top:-3px;box-shadow:0 0 8px rgba(212,175,55,.8);animation:tlDot 4.5s ease-in-out infinite;}
@keyframes tlDot{0%{left:5%;}100%{left:calc(90% - 4px);}}
.feat-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:24px;}
.fm-item{
  background:rgba(212,175,55,.04);border:1px solid rgba(212,175,55,.1);
