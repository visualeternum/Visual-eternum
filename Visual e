}
.ct-chip:hover{border-color:rgba(212,175,55,.3);background:rgba(212,175,55,.06);color:var(--gold-soft);}
.ct-chip.on{background:rgba(212,175,55,.12);border-color:rgba(212,175,55,.45);color:var(--gold);box-shadow:0 0 12px rgba(212,175,55,.08);}
.ct-submit{
