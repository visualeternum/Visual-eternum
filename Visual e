.ct-title span{color:transparent;-webkit-text-stroke:1.5px var(--gold);}
.ct-title em{color:var(--gold);font-style:normal;text-shadow:0 0 50px rgba(212,175,55,.4);}
.ct-desc{font-size:.9rem;font-weight:300;color:var(--muted);line-height:1.8;max-width:480px;margin-bottom:44px;}
.ct-desc strong{color:var(--white);font-weight:500;}

/* FORM */
.ct-form{display:flex;flex-direction:column;gap:16px;}
.ct-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.ct-field{display:flex;flex-direction:column;gap:7px;}
.ct-label{font-size:.58rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted2);}
.ct-input-wrap{position:relative;}
