.ct-survey-title{font-size:.58rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted2);margin-bottom:8px;margin-top:4px;}
.ct-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px;}
.ct-chip{
