<script>
/* ─── CURSOR ─── */
const dot=document.getElementById('cursor-dot');
const ring=document.getElementById('cursor-ring');
const cglow=document.getElementById('cursor-glow');
let mx=0,my=0,rx=0,ry=0,gx=0,gy=0;
document.addEventListener('mousemove',e=>{
  mx=e.clientX;my=e.clientY;
  dot.style.left=mx+'px';dot.style.top=my+'px';
});
const lerp=(a,b,t)=>a+(b-a)*t;
(function loop(){
  rx=lerp(rx,mx,.12);ry=lerp(ry,my,.12);
  ring.style.left=rx+'px';ring.style.top=ry+'px';
  gx=lerp(gx,mx,.06);gy=lerp(gy,my,.06);
  cglow.style.left=gx+'px';cglow.style.top=gy+'px';
  requestAnimationFrame(loop);
})();
document.querySelectorAll('a,button,select,.ct-chip').forEach(el=>{
  el.addEventListener('mouseenter',()=>document.body.classList.add('hovering'));
  el.addEventListener('mouseleave',()=>document.body.classList.remove('hovering'));
});

/* ─── PARTICLES ─── */
const canvas=document.getElementById('particles');
const ctx=canvas.getContext('2d');
let W,H;
function rsz(){W=canvas.width=canvas.offsetWidth;H=canvas.height=canvas.offsetHeight;}
window.addEventListener('resize',rsz);rsz();
class Pt{
  constructor(){this.reset(true);}
  reset(i){
    this.x=Math.random()*W;
    this.y=i?Math.random()*H:H+5;
    this.vx=(Math.random()-.5)*.25;
    this.vy=-(Math.random()*.35+.08);
    this.sz=Math.random()*1.4+.2;
    this.life=0;this.maxLife=Math.random()*220+120;
    this.col='rgba(212,175,55,';
  }
  update(){this.x+=this.vx;this.y+=this.vy;this.life++;if(this.y<-10||this.life>this.maxLife)this.reset(false);}
  draw(){
    const a=Math.sin(this.life/this.maxLife*Math.PI)*.4;
    ctx.beginPath();ctx.arc(this.x,this.y,this.sz,0,Math.PI*2);
    ctx.fillStyle=this.col+a+')';ctx.fill();
  }
}
const pts=[];for(let i=0;i<80;i++)pts.push(new Pt());
(function animP(){ctx.clearRect(0,0,W,H);pts.forEach(p=>{p.update();p.draw();});requestAnimationFrame(animP);})();

/* ─── SCROLL EFFECTS ─── */
window.addEventListener('scroll',()=>{
  const sy=window.scrollY;
  document.querySelectorAll('.blob').forEach((b,i)=>{
    b.style.transform=`translateY(${sy*([.12,.09,.18][i]||.1)}px)`;
  });
  document.getElementById('main-nav').classList.toggle('scrolled',sy>20);
});

/* ─── TITLE REVEAL ─── */
function revealWords(){
  document.querySelectorAll('.title-word').forEach(w=>{
    const d=parseFloat(w.style.getPropertyValue('--d')||'0');
    setTimeout(()=>w.classList.add('visible'),d*1000+100);
  });
}
const hObs=new IntersectionObserver(e=>{if(e[0].isIntersecting){revealWords();hObs.disconnect();}},{threshold:.1});
hObs.observe(document.getElementById('hero'));
window.addEventListener('load',revealWords);

/* ─── METRICS STAGGER ─── */
const mObs=new IntersectionObserver(e=>{
  e.forEach(en=>{
    if(en.isIntersecting){
      document.querySelectorAll('.metric').forEach((m,i)=>{
        setTimeout(()=>{m.style.animation='fadeUp .6s ease forwards';},1200+i*160);
      });
    }
  });
},{threshold:.3});
document.querySelectorAll('.hero-metrics').forEach(el=>mObs.observe(el));

/* ─── PHONE PARALLAX ─── */
const phoneSc=document.querySelector('.phone-scene');
if(phoneSc){
  document.addEventListener('mousemove',e=>{
    const rx2=(e.clientX/window.innerWidth-.5)*10;
    const ry2=(e.clientY/window.innerHeight-.5)*8;
    phoneSc.style.transform=`rotateY(${-7+rx2*.4}deg) rotateX(${3-ry2*.3}deg)`;
  });
}

/* ─── PORTFOLIO REVEAL ─── */
const portHeaderObs=new IntersectionObserver(e=>{
  e.forEach(en=>{if(en.isIntersecting){en.target.classList.add('visible');portHeaderObs.unobserve(en.target);}});
},{threshold:.2});
document.querySelectorAll('.port-header').forEach(h=>portHeaderObs.observe(h));

const reelObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      const delay=parseInt(e.target.dataset.delay||0)*170;
      setTimeout(()=>e.target.classList.add('visible'),delay);
      reelObs.unobserve(e.target);
    }
  });
},{threshold:.1});
document.querySelectorAll('.reel-card').forEach(c=>reelObs.observe(c));

/* ─── VIDEO PLACEHOLDER HIDE ─── */
document.querySelectorAll('.portfolio-video').forEach(video=>{
  video.addEventListener('loadeddata',()=>{
    const ph=video.closest('.reel-video-wrap').querySelector('.reel-video-placeholder');
    if(ph)ph.style.display='none';
  });
});

/* ─── PORTFOLIO CARD 3D TILT ─── */
document.querySelectorAll('.reel-card').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const r=card.getBoundingClientRect();
    const x=((e.clientX-r.left)/r.width-.5)*10;
    const y=((e.clientY-r.top)/r.height-.5)*-8;
    card.style.transform=`translateY(-8px) scale(1.01) rotateX(${y}deg) rotateY(${x}deg)`;
  });
  card.addEventListener('mouseleave',()=>{card.style.transform='';});
});

/* ─── SERVICES SCROLL REVEAL ─── */
const svcObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      const delay=parseInt(e.target.dataset.delay||0)*130;
      setTimeout(()=>e.target.classList.add('visible'),delay);
      svcObs.unobserve(e.target);
    }
  });
},{threshold:.12});
document.querySelectorAll('.svc-card').forEach(c=>svcObs.observe(c));

/* ─── SERVICES HEADER REVEAL ─── */
const shObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('.s-eyebrow,.s-title,.s-sub').forEach(el=>el.classList.add('visible'));
      shObs.unobserve(e.target);
    }
  });
},{threshold:.2});
document.querySelectorAll('.s-header').forEach(h=>shObs.observe(h));

/* ─── CARD MOUSE GLOW ─── */
document.querySelectorAll('.svc-card').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const r=card.getBoundingClientRect();
    card.style.setProperty('--mx',((e.clientX-r.left)/r.width*100).toFixed(1)+'%');
    card.style.setProperty('--my',((e.clientY-r.top)/r.height*100).toFixed(1)+'%');
  });
});

/* ─── CHIPS ─── */
document.querySelectorAll('#chipsType .ct-chip').forEach(chip=>{
  chip.addEventListener('click',()=>{
    chip.classList.toggle('on');
    const selected=[...document.querySelectorAll('#chipsType .ct-chip.on')]
      .map(c=>c.dataset.v).join(', ');
    document.getElementById('tipoContenido').value=selected||'No especificado';
  });
});
document.querySelectorAll('#chipsObj .ct-chip').forEach(chip=>{
  chip.addEventListener('click',()=>{
    document.querySelectorAll('#chipsObj .ct-chip').forEach(c=>c.classList.remove('on'));
    chip.classList.add('on');
    document.getElementById('objetivoHidden').value=chip.dataset.v;
  });
});

/* ─── FORM SUBMIT — Formspree (action=xjgzoejw) + WhatsApp fallback ─── */
document.getElementById('ctForm').addEventListener('submit',async function(e){
  e.preventDefault();
  const btn=this.querySelector('.ct-submit');
  const origText=btn.innerHTML;
  btn.innerHTML='Enviando... <span>◌</span>';
  btn.style.opacity='.7';
  btn.disabled=true;

  const name=document.getElementById('ctName').value.trim();
  const email=document.getElementById('ctEmail').value.trim();
  const plat=document.getElementById('ctPlat').value||'No especificada';
  const msg=document.getElementById('ctMsg').value.trim();
  const tipos=document.getElementById('tipoContenido').value||'No especificado';
  const obj=document.getElementById('objetivoHidden').value||'No especificado';

  /* 1 — FORMSPREE — mantiene action="https://formspree.io/f/xjgzoejw" */
  try{
    const formData=new FormData(this);
    const res=await fetch(this.action,{
      method:'POST',
      body:formData,
      headers:{Accept:'application/json'}
