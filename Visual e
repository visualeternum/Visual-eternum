.arc-label{font-family:'Bebas Neue',sans-serif;font-size:.7rem;fill:var(--white);text-anchor:middle;dominant-baseline:central;}
.stat-strip{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;}
.ss-pill{
