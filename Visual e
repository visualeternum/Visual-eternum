    '*Objetivo:* '+obj+
    (msg?'\n*Mensaje:* '+msg:'')
  );
  window.open('https://wa.me/573106074522?text='+waMsg,'_blank');

  this.querySelector('.ct-submit').style.display='none';
  document.getElementById('ctSuccess').style.display='block';
});
</script>

